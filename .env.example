# Copy to .env and edit. The SLURM scripts load it automatically; for interactive
# runs use `set -a; source .env; set +a`. Never commit .env.
# Values already in the environment (e.g. from `sbatch --export`) take precedence.

# ── LLM (any model served by Ollama) ────────────────────────────────────────
# llama3:8b (default), llama3:70b, qwen3:30b-a3b, qwen2.5:32b, mistral-nemo, ...
LLM_MODEL=${LLM_MODEL:-llama3:8b}
# Context window requested from Ollama, in tokens. 0 = Ollama's default.
# Llama 3 supports 8192; Qwen 2.5/3 and Llama 3.1+ support 32768 or more.
LLM_NUM_CTX=${LLM_NUM_CTX:-0}
# Step 04 chunk size in characters (~4 characters per token). 10000 fits Llama 3;
# with a long-context model use e.g. 100000 plus LLM_NUM_CTX=32768.
CHUNK_CHARS=${CHUNK_CHARS:-10000}
# Set to false for reasoning models (Qwen 3, DeepSeek-R1, ...) so they answer
# directly; leave empty for Llama 3 and other models without a thinking mode.
LLM_THINK=${LLM_THINK:-}
# true = force step 02 answers into JSON (recommended for Qwen 3 and other chatty models).
LLM_FORCE_JSON=${LLM_FORCE_JSON:-}
# Ollama servers started by step 04: 4 suits an 8B model on one GPU, 1 for 70B.
OLLAMA_SERVERS=${OLLAMA_SERVERS:-4}
# Ollama binary and model folder, if not on PATH or in ~/.ollama.
OLLAMA_BIN=${OLLAMA_BIN:-ollama}
# OLLAMA_MODELS=/path/to/ollama/models

# ── Literature APIs (leave a key empty to skip that source) ─────────────────
CONTACT_EMAIL=your_email@university.edu
SEMANTIC_SCHOLAR_API_KEY=
CORE_API_KEY=
LENS_API_KEY=
DIMENSIONS_API_KEY=

# ── Inputs ──────────────────────────────────────────────────────────────────
# Folder of paper PDFs/XMLs for step 04 (default: data/papers in this repo).
# PAPERS_DIR=/path/to/papers
